{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Selv",
  "version": "0.0.11",
  "identifier": "com.selv.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Selv - Application",
        "maximized": true,
        "width": 1200,
        "height": 750,
        "minHeight": 650,
        "minWidth": 1200
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/selv-backend"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyOUIxRTM4REE0NTFDN0MKUldSOEhFWGFPQjZiUWlqb2x2RTVLdHk3Q3hJZUdMQXlhV3o3M1gwZTllTnZ6NElOckljbCtCOVkK",
      "endpoints": ["https://github.com/Knockerr/selv/releases/latest/download/latest.json"]
    }
  }
}
